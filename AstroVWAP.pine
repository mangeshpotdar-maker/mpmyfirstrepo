//@version=6
// Note: The "Show Indicator Arguments" setting in the indicator's settings (right-click on indicator) must be unchecked manually to hide the inputs from the status line.
indicator('Astro VWAP Indicator', 'Astro VWAP', overlay = true)

// --- START --- Astro Block
// @description Holds all astrological data and settings.

// --- Default Color Constants ---
const color DEF_BULLISH_COLOR = color.new(#66bb6a, 86)
const color DEF_BEARISH_COLOR = color.new(#ffcc80, 50)
const color DEF_PDHL_COLOR = #0000FF
const color DEF_VWAP_UP_COLOR = #a5f411
const color DEF_VWAP_DOWN_COLOR = #f20f22
const color DEF_AMAVASYA_LINE_COLOR = #FF000080
const color DEF_PURNIMA_LINE_COLOR = #00800080
const color DEF_PUSHYA_LINE_COLOR = #FFFF0080
const color DEF_ECLIPSE_LINE_COLOR = #80808080

// --- Ultimate Crossover Signal Settings ---
useUltimateCrossover = input.bool(true, title = 'Use Ultimate Crossover Signal', group = 'Ultimate Crossover Settings')
ultimateMaType = input.string('EMA', title = 'MA Type', options = ['EMA', 'SMA', 'WMA', 'HMA'], group = 'Ultimate Crossover Settings')
ultimateMaPeriod = input.int(108, title = 'MA Period', group = 'Ultimate Crossover Settings')
ultimateMaColor = input.color(color.new(#FFD700, 0), title='MA Color', group='Ultimate Crossover Settings')
ultimateMaWidth = input.int(2, title='MA Width', group='Ultimate Crossover Settings')
showUltimateMaLine = input.bool(true, title='Show MA Line', group='Ultimate Crossover Settings')
showUltimateCrossoverAlerts = input.bool(true, title = 'Show Alerts', group = 'Ultimate Crossover Settings')
colorUltimateCandles = input.bool(true, title = 'Color Candles', group = 'Ultimate Crossover Settings')
ultimateBullColor = input.color(color.new(#40a998, 0), title = 'Bullish Color', group = 'Ultimate Crossover Settings')
ultimateBearColor = input.color(color.new(#f02131, 90), title = 'Bearish Color', group = 'Ultimate Crossover Settings')
colorProximityCandles = input.bool(true, title = 'Color Proximity Candles', group = 'Ultimate Crossover Settings')
proximityAtrMultiplier = input.float(1.0, title = 'Proximity ATR Multiplier', group = 'Ultimate Crossover Settings')


// --- Regression Channel Settings ---
showRegressionChannel = input.bool(false, title = 'Show Regression Channel', group = 'Regression Channel')
lengthInput = input.int(100, "Length", minval = 1, maxval = 5000, group = 'Regression Channel')
sourceInput = input.source(close, "Source", group = 'Regression Channel')
useUpperDevInput = input.bool(true, "Upper Deviation", inline = "Upper Deviation", group = 'Regression Channel')
upperMultInput = input.float(2.0, "", inline = "Upper Deviation", group = 'Regression Channel')
useLowerDevInput = input.bool(true, "Lower Deviation", inline = "Lower Deviation", group = 'Regression Channel')
lowerMultInput = input.float(2.0, "", inline = "Lower Deviation", group = 'Regression Channel')
showPearsonInput = input.bool(true, "Show Pearson's R", group = 'Regression Channel')
extendLeftInput = input.bool(false, "Extend Lines Left", group = 'Regression Channel')
extendRightInput = input.bool(true, "Extend Lines Right", group = 'Regression Channel')
colorUpper = input.color(color.new(color.blue, 85), "Upper Color", group = 'Regression Channel')
colorLower = input.color(color.new(color.red, 85), "Lower Color", group = 'Regression Channel')

// --- Main Settings ---
showPurnimaAmavasya = input.bool(true, title = 'Show Purnima/Amavasya Events', group = 'Display Settings')
showPushyaNakshatra = input.bool(true, title = 'Show Pushya Nakshatra Events', group = 'Display Settings')
showEclipses = input.bool(true, title = 'Show Eclipse Events', group = 'Display Settings')
showSolsticesEquinoxes = input.bool(true, title = 'Show Solstice/Equinox Events', group = 'Display Settings')
showVWAP = input.bool(false, title = 'Show VWAP', group = 'Display Settings')
showSmoothedVWAP = input.bool(true, title = 'Show Smoothed VWAP', group = 'Display Settings')

// --- Signal Settings ---
showSignals = input.bool(true, title = 'Show Buy/Sell Signals', group = 'Signal Settings')
useVwapSlopeFilter = input.bool(true, title = 'Filter Signals by VWAP Slope', group = 'Signal Settings')
useEmaTrendFilter = input.bool(false, title = 'Filter Signals by Long-Term EMA', group = 'Signal Settings')
showEmaFilter = input.bool(true, title = 'Show EMA Filter Line', group = 'Signal Settings')
emaFilterLength = input.int(108, title = 'EMA Filter Length', group = 'Signal Settings')
emaFilterColor = input.color(color.new(#FFD700, 0), title='EMA Filter Color', group='Signal Settings')
emaFilterWidth = input.int(2, title='EMA Filter Width', group='Signal Settings')
showBuySellAlerts = input.bool(false, title = 'Show Crossover Alerts', group = 'Signal Settings')
showReversalAlerts = input.bool(true, title = 'Show VWAP Reversal Alerts', group = 'Signal Settings')
showRsiCrossoverAlerts = input.bool(true, title = 'Show RSI Crossover Alerts', group = 'Signal Settings')

showBgColor = input.bool(true, title = 'Show Background Coloring', group = 'Display Settings')
bullishColor = input.color(DEF_BULLISH_COLOR, title = 'Bullish Color', group = 'Display Settings')
bearishColor = input.color(DEF_BEARISH_COLOR, title = 'Bearish Color', group = 'Display Settings')
showPDHL = input.bool(true, title = 'Show Previous Day High/Low', group = 'Display Settings')
pdhlColor = input.color(DEF_PDHL_COLOR, title = 'PDHL Color', group = 'Display Settings')
pdhlWidth = input.int(2, title = 'PDHL Width', group = 'Display Settings')
showTrendTable = input.bool(true, title = 'Show Trend Table', group = 'Table Settings')
showPriceTable = input.bool(true, title = 'Show Price Table', group = 'Table Settings')
showUltimateSignalTable = input.bool(true, title = 'Show Ultimate Signal Table', group = 'Table Settings')
showRsiSignalTable = input.bool(true, title = 'Show RSI Signal Table', group = 'Table Settings')
colorHighVolume = input.bool(true, title = 'Color High Volume Candles', group = 'Display Settings')
showRSICrossover = input.bool(true, title = 'Show RSI Crossover Candles', group = 'Display Settings')
showMPGannPivot = input.bool(true, title = 'Show MP Gann Pivot', group = 'Display Settings')

// --- Opening Range Settings ---
showOpeningRange = input.bool(true, title = 'Show Opening Range H/L', group = 'Opening Range Settings')
openingRangeDuration = input.string('15 min', 'Duration', options = ['15 min', '30 min', '1 Hour', '75 Min', '2 Hour'], group = 'Opening Range Settings')
openingRangeColor = input.color(DEF_PDHL_COLOR, title = 'Color', group = 'Opening Range Settings')
openingRangeWidth = input.int(2, title = 'Width', group = 'Opening Range Settings')


vwapUpColor = input.color(DEF_VWAP_UP_COLOR, title = 'VWAP Up Color', group = 'VWAP Settings')
vwapDownColor = input.color(DEF_VWAP_DOWN_COLOR, title = 'VWAP Down Color', group = 'VWAP Settings')

// --- RSI Settings ---
rsiLength = input.int(14, title = 'RSI Length', group = 'RSI Settings')
rsiCrossoverThreshold = input.int(55, title = 'RSI Crossover Threshold', group = 'RSI Settings')
showRsiCrossunder = input.bool(true, title = 'Show RSI Crossunder Signal', group = 'RSI Settings')
rsiCrossunderThreshold = input.int(55, title = 'RSI Crossunder Threshold', group = 'RSI Settings')
rsiCrossunderColor = input.color(color.new(#9C27B0, 40), title = 'RSI Crossunder Color', group = 'RSI Settings')
rsiSmoothingType = input.string('EMA', title = 'RSI Smoothing Type', options = ['SMA', 'EMA', 'TMA', 'HMA'], group = 'RSI Settings')
rsiSmoothingLength = input.int(3, title = 'RSI Smoothing Length', group = 'RSI Settings')
showRsiCrossoverLines = input.bool(true, title = 'Show RSI Crossover Lines & Labels', group = 'RSI Settings')


// --- Vertical Line Settings ---
showVerticalLines = input.bool(true, title = 'Show Vertical Event Lines', group = 'Display Settings')
amavasyaLineColor = input.color(DEF_AMAVASYA_LINE_COLOR, title = 'Amavasya Line Color', group = 'Display Settings')
purnimaLineColor = input.color(DEF_PURNIMA_LINE_COLOR, title = 'Purnima Line Color', group = 'Display Settings')
pushyaLineColor = input.color(DEF_PUSHYA_LINE_COLOR, title = 'Pushya Nakshatra Line Color', group = 'Display Settings')
eclipseLineColor = input.color(DEF_ECLIPSE_LINE_COLOR, title = 'Eclipse/Solstice Line Color', group = 'Display Settings')
lineWidth = input.int(2, title = 'Line Width', group = 'Display Settings')

// --- Day Separator Settings ---
showDaySeparator = input.bool(true, title = 'Show Day Separator', group = 'Display Settings')
separatorColor = input.color(color.new(#787b86, 0), title = 'Separator Color', group = 'Display Settings')
separatorStyle = input.string(line.style_solid, 'Separator Style', options = [line.style_solid, line.style_dotted, line.style_dashed], group = 'Display Settings')
separatorWidth = input.int(2, title = 'Separator Width', group = 'Display Settings')

// --- Table Settings ---
trendTablePosition = input.string(position.bottom_right, 'Trend Table Position', options = [position.top_left, position.top_center, position.top_right, position.middle_left, position.middle_center, position.middle_right, position.bottom_left, position.bottom_center, position.bottom_right], group = 'Table Settings')
priceTablePosition = input.string(position.bottom_left, 'Price Table Position', options = [position.top_left, position.top_center, position.top_right, position.middle_left, position.middle_center, position.middle_right, position.bottom_left, position.bottom_center, position.bottom_right], group = 'Table Settings')
ultimateSignalTablePosition = input.string(position.top_right, 'Ultimate Signal Table Position', options = [position.top_left, position.top_center, position.top_right, position.middle_left, position.middle_center, position.middle_right, position.bottom_left, position.bottom_center, position.bottom_right], group = 'Table Settings')
rsiSignalTablePosition = input.string(position.middle_right, 'RSI Signal Table Position', options = [position.top_left, position.top_center, position.top_right, position.middle_left, position.middle_center, position.middle_right, position.bottom_left, position.bottom_center, position.bottom_right], group = 'Table Settings')
tableBgColor = input.color(color.new(color.gray, 80), 'Table BG Color', group = 'Table Settings')
tableBorderColor = input.color(color.black, 'Table Border Color', group = 'Table Settings')

// --- Amavasya Dates ---
var amavasyaDates = array.from(timestamp('Asia/Kolkata', 2024, 1, 11, 5, 57), timestamp('Asia/Kolkata', 2024, 2, 9, 16, 0), timestamp('Asia/Kolkata', 2024, 3, 10, 14, 1), timestamp('Asia/Kolkata', 2024, 4, 8, 23, 19), timestamp('Asia/Kolkata', 2024, 5, 8, 8, 57), timestamp('Asia/Kolkata', 2024, 6, 6, 17, 38), timestamp('Asia/Kolkata', 2024, 7, 6, 6, 0), timestamp('Asia/Kolkata', 2024, 8, 4, 19, 14), timestamp('Asia/Kolkata', 2024, 9, 3, 9, 26), timestamp('Asia/Kolkata', 2024, 10, 2, 23, 25), timestamp('Asia/Kolkata', 2024, 11, 1, 12, 3), timestamp('Asia/Kolkata', 2024, 12, 1, 0, 32), timestamp('Asia/Kolkata', 2025, 1, 29, 9, 54), timestamp('Asia/Kolkata', 2025, 2, 28, 15, 5), timestamp('Asia/Kolkata', 2025, 3, 29, 18, 43), timestamp('Asia/Kolkata', 2025, 4, 28, 22, 20), timestamp('Asia/Kolkata', 2025, 5, 28, 2, 37), timestamp('Asia/Kolkata', 2025, 6, 26, 8, 1), timestamp('Asia/Kolkata', 2025, 7, 25, 15, 12), timestamp('Asia/Kolkata', 2025, 8, 24, 1, 51), timestamp('Asia/Kolkata', 2025, 9, 22, 16, 1), timestamp('Asia/Kolkata', 2025, 10, 22, 8, 25), timestamp('Asia/Kolkata', 2025, 11, 21, 3, 30), timestamp('Asia/Kolkata', 2025, 12, 20, 22, 20), timestamp('Asia/Kolkata', 2026, 1, 19, 15, 8), timestamp('Asia/Kolkata', 2026, 2, 18, 4, 39), timestamp('Asia/Kolkata', 2026, 3, 19, 14, 57), timestamp('Asia/Kolkata', 2026, 4, 17, 23, 13), timestamp('Asia/Kolkata', 2026, 5, 17, 6, 3), timestamp('Asia/Kolkata', 2026, 6, 15, 13, 28), timestamp('Asia/Kolkata', 2026, 7, 14, 22, 21), timestamp('Asia/Kolkata', 2026, 8, 13, 9, 13), timestamp('Asia/Kolkata', 2026, 9, 11, 22, 9), timestamp('Asia/Kolkata', 2026, 10, 11, 13, 1), timestamp('Asia/Kolkata', 2026, 11, 10, 8, 0), timestamp('Asia/Kolkata', 2026, 12, 10, 4, 28))

// --- Purnima Dates ---
var purnimaDates = array.from(timestamp('Asia/Kolkata', 2024, 1, 25, 5, 54), timestamp('Asia/Kolkata', 2024, 2, 24, 18, 39), timestamp('Asia/Kolkata', 2024, 3, 25, 12, 3), timestamp('Asia/Kolkata', 2024, 4, 24, 8, 17), timestamp('Asia/Kolkata', 2024, 5, 23, 6, 47), timestamp('Asia/Kolkata', 2024, 6, 22, 7, 8), timestamp('Asia/Kolkata', 2024, 7, 21, 9, 38), timestamp('Asia/Kolkata', 2024, 8, 19, 14, 0), timestamp('Asia/Kolkata', 2024, 9, 18, 20, 34), timestamp('Asia/Kolkata', 2024, 10, 17, 5, 19), timestamp('Asia/Kolkata', 2024, 11, 15, 16, 17), timestamp('Asia/Kolkata', 2024, 12, 15, 5, 15), timestamp('Asia/Kolkata', 2025, 1, 13, 19, 24), timestamp('Asia/Kolkata', 2025, 2, 12, 9, 49), timestamp('Asia/Kolkata', 2025, 3, 13, 23, 39), timestamp('Asia/Kolkata', 2025, 4, 12, 11, 33), timestamp('Asia/Kolkata', 2025, 5, 12, 21, 14), timestamp('Asia/Kolkata', 2025, 6, 11, 5, 13), timestamp('Asia/Kolkata', 2025, 7, 10, 12, 23), timestamp('Asia/Kolkata', 2025, 8, 8, 19, 19), timestamp('Asia/Kolkata', 2025, 9, 7, 3, 5), timestamp('Asia/Kolkata', 2025, 10, 6, 12, 4), timestamp('Asia/Kolkata', 2025, 11, 4, 23, 21), timestamp('Asia/Kolkata', 2025, 12, 4, 13, 0), timestamp('Asia/Kolkata', 2026, 1, 3, 4, 14), timestamp('Asia/Kolkata', 2026, 2, 1, 20, 3), timestamp('Asia/Kolkata', 2026, 3, 3, 10, 34), timestamp('Asia/Kolkata', 2026, 4, 2, 0, 15), timestamp('Asia/Kolkata', 2026, 5, 1, 11, 22), timestamp('Asia/Kolkata', 2026, 5, 30, 20, 55), timestamp('Asia/Kolkata', 2026, 6, 29, 5, 6), timestamp('Asia/Kolkata', 2026, 7, 28, 12, 32), timestamp('Asia/Kolkata', 2026, 8, 26, 20, 9), timestamp('Asia/Kolkata', 2026, 9, 25, 4, 49), timestamp('Asia/Kolkata', 2026, 10, 24, 15, 7), timestamp('Asia/Kolkata', 2026, 11, 23, 3, 27), timestamp('Asia/Kolkata', 2026, 12, 22, 17, 7))

// --- Pushya Nakshatra Dates ---
var pushyaNakshatraDates = array.from(timestamp('Asia/Kolkata', 2024, 1, 26, 10, 28), timestamp('Asia/Kolkata', 2024, 5, 14, 13, 5), timestamp('Asia/Kolkata', 2024, 8, 4, 13, 26), timestamp('Asia/Kolkata', 2024, 9, 28, 13, 20), timestamp('Asia/Kolkata', 2025, 1, 15, 10, 28), timestamp('Asia/Kolkata', 2025, 10, 15, 12, 0), timestamp('Asia/Kolkata', 2026, 1, 5, 13, 25), timestamp('Asia/Kolkata', 2026, 3, 28, 14, 50), timestamp('Asia/Kolkata', 2026, 6, 18, 11, 33), timestamp('Asia/Kolkata', 2026, 8, 12, 10, 9))

// --- Eclipse Dates ---
var eclipseDates = array.from(timestamp('Asia/Kolkata', 2024, 3, 25, 12, 30), timestamp('Asia/Kolkata', 2024, 9, 18, 8, 11), timestamp('Asia/Kolkata', 2025, 3, 14, 12, 25), timestamp('Asia/Kolkata', 2025, 9, 7, 23, 42), timestamp('Asia/Kolkata', 2026, 3, 3, 16, 54), timestamp('Asia/Kolkata', 2026, 8, 28, 9, 47))

// --- Solstice and Equinox Dates ---
var solsticeEquinoxDates = array.from(timestamp('Asia/Kolkata', 2024, 3, 20, 8, 36), timestamp('Asia/Kolkata', 2024, 6, 21, 2, 20), timestamp('Asia/Kolkata', 2024, 9, 22, 18, 13), timestamp('Asia/Kolkata', 2024, 12, 21, 14, 50), timestamp('Asia/Kolkata', 2025, 3, 20, 14, 31), timestamp('Asia/Kolkata', 2025, 6, 21, 8, 12), timestamp('Asia/Kolkata', 2025, 9, 22, 23, 49), timestamp('Asia/Kolkata', 2025, 12, 21, 20, 33), timestamp('Asia/Kolkata', 2026, 3, 20, 20, 16), timestamp('Asia/Kolkata', 2026, 6, 21, 13, 54), timestamp('Asia/Kolkata', 2026, 9, 23, 5, 35), timestamp('Asia/Kolkata', 2026, 12, 22, 2, 20))

// --- END --- Astro Block

// --- START --- Moon Phase Logic
// @description Determines the lunar cycle and applies background coloring.

// Find the current lunar cycle
var purnimaIdx = 0
var amavasyaIdx = 0

if array.size(purnimaDates) > 0
    while purnimaIdx < array.size(purnimaDates) and array.get(purnimaDates, purnimaIdx) < time
        purnimaIdx := purnimaIdx + 1

if array.size(amavasyaDates) > 0
    while amavasyaIdx < array.size(amavasyaDates) and array.get(amavasyaDates, amavasyaIdx) < time
        amavasyaIdx := amavasyaIdx + 1

lastPurnima = purnimaIdx > 0 ? array.get(purnimaDates, purnimaIdx - 1) : na
lastAmavasya = amavasyaIdx > 0 ? array.get(amavasyaDates, amavasyaIdx - 1) : na

// Determine background color based on the lunar cycle
// Bullish phase: Purnima to Amavasya (Green)
// Bearish phase: Amavasya to Purnima (Red)
var color bgColor = na
if not na(lastPurnima) and not na(lastAmavasya)
    if lastPurnima > lastAmavasya
        bgColor := bullishColor
    else
        bgColor := bearishColor
else if na(lastPurnima) and not na(lastAmavasya)
    bgColor := bearishColor
else if not na(lastPurnima) and na(lastAmavasya)
    bgColor := bullishColor


bgcolor(showBgColor ? bgColor : na)

// --- END --- Moon Phase Logic

// --- START --- VWAP Block
// @description Calculates and plots the VWAP and smoothed VWAP.

// --- Inputs ---
vwapPeriod = input.int(5, title = 'VWAP Period', group = 'VWAP Settings')
smoothingType = input.string('EMA', title = 'Smoothing Type', options = ['EMA', 'WMA', 'SMA', 'HMA'], group = 'VWAP Settings')
smoothingLength = input.int(5, title = 'Smoothing Length', group = 'VWAP Settings')

// Anchored VWAP Inputs
showWeeklyAVWAP = input.bool(false, title = 'Show Weekly AVWAP', group = 'Anchored VWAP Settings')
weeklyAVWAPColor = input.color(#2962FF, title = 'Weekly AVWAP Color', group = 'Anchored VWAP Settings')
weeklySmoothingType = input.string('EMA', title = 'Weekly Smoothing Type', options = ['EMA', 'WMA', 'SMA', 'HMA'], group = 'Anchored VWAP Settings')
weeklySmoothingLength = input.int(5, title = 'Weekly Smoothing Length', group = 'Anchored VWAP Settings')

showMonthlyAVWAP = input.bool(false, title = 'Show Monthly AVWAP', group = 'Anchored VWAP Settings')
monthlyAVWAPColor = input.color(#FF6D00, title = 'Monthly AVWAP Color', group = 'Anchored VWAP Settings')
monthlySmoothingType = input.string('EMA', title = 'Monthly Smoothing Type', options = ['EMA', 'WMA', 'SMA', 'HMA'], group = 'Anchored VWAP Settings')
monthlySmoothingLength = input.int(5, title = 'Monthly Smoothing Length', group = 'Anchored VWAP Settings')


// --- Calculations ---
// MVWAP calculation with EMA fallback
vwap_calculation = ta.sma(hlc3 * volume, vwapPeriod) / ta.sma(volume, vwapPeriod)
ema_fallback = ta.ema(hlc3, vwapPeriod)
vwapValue = not na(volume) ? vwap_calculation : ema_fallback

// Anchored VWAP Calculations
isNewWeek = ta.change(time('W')) != 0
isNewMonth = ta.change(time('M')) != 0

// Weekly AVWAP
var float weeklySumSrcVol = 0.0
var float weeklySumVol = 0.0
weeklySumSrcVol := isNewWeek ? hlc3 * volume : weeklySumSrcVol + hlc3 * volume
weeklySumVol := isNewWeek ? volume : weeklySumVol + volume
weeklyAVWAP = weeklySumSrcVol / weeklySumVol

// Monthly AVWAP
var float monthlySumSrcVol = 0.0
var float monthlySumVol = 0.0
monthlySumSrcVol := isNewMonth ? hlc3 * volume : monthlySumSrcVol + hlc3 * volume
monthlySumVol := isNewMonth ? volume : monthlySumVol + volume
monthlyAVWAP = monthlySumSrcVol / monthlySumVol


// Smoothed VWAP calculation
emaSmoothed = ta.ema(vwapValue, smoothingLength)
wmaSmoothed = ta.wma(vwapValue, smoothingLength)
smaSmoothed = ta.sma(vwapValue, smoothingLength)
hmaSmoothed = ta.hma(vwapValue, smoothingLength)

smoothedVwapValue = switch smoothingType
    'EMA' => emaSmoothed
    'WMA' => wmaSmoothed
    'SMA' => smaSmoothed
    'HMA' => hmaSmoothed

// Smoothed Weekly AVWAP
weeklyEmaSmoothed = ta.ema(weeklyAVWAP, weeklySmoothingLength)
weeklyWmaSmoothed = ta.wma(weeklyAVWAP, weeklySmoothingLength)
weeklySmaSmoothed = ta.sma(weeklyAVWAP, weeklySmoothingLength)
weeklyHmaSmoothed = ta.hma(weeklyAVWAP, weeklySmoothingLength)

smoothedWeeklyAVWAP = switch weeklySmoothingType
    'EMA' => weeklyEmaSmoothed
    'WMA' => weeklyWmaSmoothed
    'SMA' => weeklySmaSmoothed
    'HMA' => weeklyHmaSmoothed

// Smoothed Monthly AVWAP
monthlyEmaSmoothed = ta.ema(monthlyAVWAP, monthlySmoothingLength)
monthlyWmaSmoothed = ta.wma(monthlyAVWAP, monthlySmoothingLength)
monthlySmaSmoothed = ta.sma(monthlyAVWAP, monthlySmoothingLength)
monthlyHmaSmoothed = ta.hma(monthlyAVWAP, monthlySmoothingLength)

smoothedMonthlyAVWAP = switch monthlySmoothingType
    'EMA' => monthlyEmaSmoothed
    'WMA' => monthlyWmaSmoothed
    'SMA' => monthlySmaSmoothed
    'HMA' => monthlyHmaSmoothed

// --- Plotting ---
vwapSlope = smoothedVwapValue - smoothedVwapValue[1]
vwapColor = vwapSlope > 0 ? vwapUpColor : vwapDownColor
plot(showVWAP ? vwapValue : na, title = 'VWAP', color = #0000FF)
plot(showSmoothedVWAP ? smoothedVwapValue : na, title = 'Smoothed VWAP', color = vwapColor, linewidth = 2)

// Plot Anchored VWAPs
plot(showWeeklyAVWAP ? smoothedWeeklyAVWAP : na, title = 'Weekly AVWAP', color = weeklyAVWAPColor)
plot(showMonthlyAVWAP ? smoothedMonthlyAVWAP : na, title = 'Monthly AVWAP', color = monthlyAVWAPColor)

// --- VWAP Turning Points ---
vwapTurnUp = vwapSlope > 0 and vwapSlope[1] <= 0
vwapTurnDown = vwapSlope < 0 and vwapSlope[1] >= 0

var int barsSinceTurnUp = na
var int barsSinceTurnDown = na

if vwapTurnUp
    barsSinceTurnUp := 0
if vwapTurnDown
    barsSinceTurnDown := 0

if not na(barsSinceTurnUp)
    barsSinceTurnUp := barsSinceTurnUp + 1
if not na(barsSinceTurnDown)
    barsSinceTurnDown := barsSinceTurnDown + 1

flashColorUp = barsSinceTurnUp < 5 and bar_index % 2 == 0 ? color.yellow : color.white
flashColorDown = barsSinceTurnDown < 5 and bar_index % 2 == 0 ? color.yellow : color.white


// --- END --- VWAP Block

// --- START --- RSI Crossover Block
// @description Handles the RSI Crossover detection and plotting.

// --- RSI Calculation ---
rsiValue = ta.rsi(close, rsiLength)

// Smoothed RSI calculation
rsiEmaSmoothed = ta.ema(rsiValue, rsiSmoothingLength)
rsiWmaSmoothed = ta.wma(rsiValue, rsiSmoothingLength)
rsiSmaSmoothed = ta.sma(rsiValue, rsiSmoothingLength)
rsiHmaSmoothed = ta.hma(rsiValue, rsiSmoothingLength)
// Correct TMA calculation
tma_len1 = math.ceil(rsiSmoothingLength / 2)
tma_len2 = math.floor(rsiSmoothingLength / 2) + 1
rsiTmaSmoothed = ta.sma(ta.sma(rsiValue, tma_len1), tma_len2)


smoothedRsi = switch rsiSmoothingType
    'EMA' => rsiEmaSmoothed
    'WMA' => rsiWmaSmoothed
    'SMA' => rsiSmaSmoothed
    'HMA' => rsiHmaSmoothed
    'TMA' => rsiTmaSmoothed


rsiCrossover = ta.crossover(smoothedRsi, rsiCrossoverThreshold)
rsiCrossunder = ta.crossunder(smoothedRsi, rsiCrossunderThreshold)

// --- END --- RSI Crossover Block

// --- START --- MP Gann Pivot Block
// @description Calculates and plots the MP Gann Pivot for the period of Sep 1 to Sep 9.
var line gannPivotLine = na
var label gannPivotLabel = na
// --- Gann Pivot Calculation ---
// Define the Gann period
isGannPeriod = month == 9 and dayofmonth >= 1 and dayofmonth <= 9

// Variables to store the cumulative values during the Gann period
var float gannOpen = na
var float gannHigh = na
var float gannLow = na
var float gannClose = na

// Reset on the first day of the period
if isGannPeriod and dayofmonth == 1 and dayofmonth[1] != 1
    gannOpen := open
    gannHigh := high
    gannLow := low
    gannClose := close
else if isGannPeriod
    gannHigh := math.max(gannHigh, high)
    gannLow := math.min(gannLow, low)
    gannClose := close

// Calculate and plot the pivot after the period ends
if month == 9 and dayofmonth == 10 and dayofmonth[1] == 9
    gannPivot = (gannOpen + gannHigh + gannLow + gannClose) / 4
    if showMPGannPivot
        line.delete(gannPivotLine)
        label.delete(gannPivotLabel)
        gannPivotLine := line.new(bar_index, gannPivot, bar_index + 1, gannPivot, extend = extend.right, color = pdhlColor, width = pdhlWidth, style = line.style_dashed)
        gannPivotLabel := label.new(time + 86400000, gannPivot, 'MP Gann Pivot: ' + str.tostring(gannPivot, format.mintick), style = label.style_none, textcolor = pdhlColor, xloc = xloc.bar_time)

// --- END --- MP Gann Pivot Block

// --- START --- Ultimate Crossover Block
// @description Calculates and plots the Ultimate Crossover Signal.

// --- Calculation ---
ultimateMa = switch ultimateMaType
    'EMA' => ta.ema(close, ultimateMaPeriod)
    'SMA' => ta.sma(close, ultimateMaPeriod)
    'WMA' => ta.wma(close, ultimateMaPeriod)
    'HMA' => ta.hma(close, ultimateMaPeriod)

// --- Signal Logic ---
ultimateBuySignal = ta.crossover(close, ultimateMa)
ultimateSellSignal = ta.crossunder(close, ultimateMa)

// --- Plotting ---
plot(showUltimateMaLine ? ultimateMa : na, title='Ultimate MA', color=ultimateMaColor, linewidth=ultimateMaWidth, trackprice=true)

// --- END --- Ultimate Crossover Block

// --- START --- Signals Block
// @description Generates and plots buy/sell signals based on VWAP crossover and lunar phase.

// --- Signal Logic ---
isBullishPhase = lastPurnima > lastAmavasya
isBearishPhase = lastAmavasya > lastPurnima

// The core signal trigger is now the VWAP turning up or down.
buy_signal_raw = vwapTurnUp
sell_signal_raw = vwapTurnDown

// --- Trend Filters ---

// VWAP Slope Filter
vwap_buy_filter = useVwapSlopeFilter ? vwapSlope > 0 : true
vwap_sell_filter = useVwapSlopeFilter ? vwapSlope < 0 : true

// Long-Term EMA Trend Filter
longEma = ta.ema(close, emaFilterLength)
plot(showEmaFilter ? longEma : na, title='EMA Filter', color=emaFilterColor, linewidth=emaFilterWidth)
ema_buy_filter = useEmaTrendFilter ? close > longEma : true
ema_sell_filter = useEmaTrendFilter ? close < longEma : true

// Combine all filters
buySignal = buy_signal_raw[1] and isBullishPhase and vwap_buy_filter and ema_buy_filter
sellSignal = sell_signal_raw[1] and isBearishPhase and vwap_sell_filter and ema_sell_filter

// --- END --- Signals Block

// --- START --- Plotting Block
// @description Plots all astrological event labels on the chart.

// --- Event Labels ---

// --- Previous Week High/Low for Label Positioning ---
prevWeekHigh = request.security(syminfo.tickerid, 'W', high[1], lookahead = barmerge.lookahead_on)
prevWeekLow = request.security(syminfo.tickerid, 'W', low[1], lookahead = barmerge.lookahead_on)

// Fallback for positioning if weekly data is not available
highestFallback = ta.highest(high, 200)
lowestFallback = ta.lowest(low, 200)
stableHigh = na(prevWeekHigh) ? highestFallback : prevWeekHigh
stableLow = na(prevWeekLow) ? lowestFallback : prevWeekLow

// Define y-coordinates for labels
yPosAbove = stableHigh + 200 * syminfo.mintick
yPosBelow = stableLow - 200 * syminfo.mintick


// Event plotting logic
const int max_drawings = 50
var eventLines = array.new_line()
var eventLabels = array.new_label()
var signalLabels = array.new_label()
var rsiLabels = array.new_label()

if showRSICrossover and rsiCrossover and not useUltimateCrossover
    array.push(rsiLabels, label.new(bar_index, high, '📈 RSI > ' + str.tostring(rsiCrossoverThreshold), yloc = yloc.abovebar, style = label.style_label_down, color = color.new(color.green, 85), textcolor = color.green, size = size.small))

if array.size(rsiLabels) > max_drawings
    label.delete(array.shift(rsiLabels))

if showRsiCrossunder and rsiCrossunder and not useUltimateCrossover
    array.push(rsiLabels, label.new(bar_index, low, '📉 RSI < ' + str.tostring(rsiCrossunderThreshold), yloc = yloc.belowbar, style = label.style_label_up, color = color.new(color.red, 85), textcolor = color.red, size = size.small))

if buySignal and showSignals and not useUltimateCrossover
    array.push(signalLabels, label.new(bar_index, low, '🚀 Buy', style = label.style_label_up, color = color.new(color.green, 20), textcolor = color.white, size = size.normal, yloc = yloc.belowbar))

if sellSignal and showSignals and not useUltimateCrossover
    array.push(signalLabels, label.new(bar_index, high, '💥 Sell', style = label.style_label_down, color = color.new(color.red, 20), textcolor = color.white, size = size.normal, yloc = yloc.abovebar))

bullishReversalSignal = vwapTurnUp and isBullishPhase
bearishReversalSignal = vwapTurnDown and isBearishPhase

if bullishReversalSignal and not useUltimateCrossover
    array.push(signalLabels, label.new(bar_index, na, '🔥 Reversal Point', yloc = yloc.belowbar, style = label.style_label_up, color = color.new(color.green, 100), textcolor = color.new(color.green, 0), size = size.small))

if bearishReversalSignal and not useUltimateCrossover
    array.push(signalLabels, label.new(bar_index, na, '🔥 Reversal Point', yloc = yloc.abovebar, style = label.style_label_down, color = color.new(color.red, 100), textcolor = color.new(color.red, 0), size = size.small))

// --- Ultimate Crossover Labels ---
var line latestSignalLine = na
var label latestSignalLabel = na

if useUltimateCrossover and (ultimateBuySignal or ultimateSellSignal)
    // Delete old line and label
    line.delete(latestSignalLine)
    label.delete(latestSignalLabel)

    // Create new line and label
    latestSignalLine := line.new(bar_index, close, bar_index + 1, close, extend = extend.right, color = ultimateBuySignal ? color.green : color.red, width = 2)
    latestSignalLabel := label.new(time + 86400000, close, ultimateBuySignal ? 'Ultimate Buy' : 'Ultimate Sell', style = label.style_none, textcolor = ultimateBuySignal ? color.green : color.red, xloc = xloc.bar_time)

if useUltimateCrossover and ultimateBuySignal
    label.new(bar_index, low, '🚀 Ultimate Buy', style = label.style_label_up, color = color.new(color.green, 20), textcolor = color.white, size = size.small, yloc = yloc.belowbar)

if useUltimateCrossover and ultimateSellSignal
    label.new(bar_index, high, '💥 Ultimate Sell', style = label.style_label_down, color = color.new(color.red, 20), textcolor = color.white, size = size.small, yloc = yloc.abovebar)

plotshape(bullishReversalSignal, style = shape.diamond, location = location.belowbar, color = color.new(color.green, 0), size = size.tiny)
plotshape(bearishReversalSignal, style = shape.diamond, location = location.abovebar, color = color.new(color.red, 0), size = size.tiny)

if array.size(signalLabels) > max_drawings
    label.delete(array.shift(signalLabels))

var amavasyaLabelIdx = 0
var purnimaLabelIdx = 0
var pushyaLabelIdx = 0
var eclipseLabelIdx = 0
var solsticeEquinoxLabelIdx = 0

if showPurnimaAmavasya and amavasyaLabelIdx < array.size(amavasyaDates)
    while amavasyaLabelIdx < array.size(amavasyaDates) and array.get(amavasyaDates, amavasyaLabelIdx) <= time
        if time >= array.get(amavasyaDates, amavasyaLabelIdx) and time[1] < array.get(amavasyaDates, amavasyaLabelIdx)
            array.push(eventLabels, label.new(x = time, y = yPosAbove, text = '🌑', style = label.style_none, textcolor = #FFFFFF, size = size.huge, tooltip = 'Amavasya', xloc = xloc.bar_time))
            if showVerticalLines
                line newLine = line.new(bar_index, low, bar_index, high, color = amavasyaLineColor, width = lineWidth, extend = extend.both)
                array.push(eventLines, newLine)
        amavasyaLabelIdx := amavasyaLabelIdx + 1

if showPurnimaAmavasya and purnimaLabelIdx < array.size(purnimaDates)
    while purnimaLabelIdx < array.size(purnimaDates) and array.get(purnimaDates, purnimaLabelIdx) <= time
        if time >= array.get(purnimaDates, purnimaLabelIdx) and time[1] < array.get(purnimaDates, purnimaLabelIdx)
            array.push(eventLabels, label.new(x = time, y = yPosAbove, text = '🌕', style = label.style_none, textcolor = #FFFFFF, size = size.huge, tooltip = 'Purnima', xloc = xloc.bar_time))
            if showVerticalLines
                line newLine = line.new(bar_index, low, bar_index, high, color = purnimaLineColor, width = lineWidth, extend = extend.both)
                array.push(eventLines, newLine)
        purnimaLabelIdx := purnimaLabelIdx + 1

if showPushyaNakshatra and pushyaLabelIdx < array.size(pushyaNakshatraDates)
    while pushyaLabelIdx < array.size(pushyaNakshatraDates) and array.get(pushyaNakshatraDates, pushyaLabelIdx) <= time
        if time >= array.get(pushyaNakshatraDates, pushyaLabelIdx) and time[1] < array.get(pushyaNakshatraDates, pushyaLabelIdx)
            array.push(eventLabels, label.new(x = time, y = yPosAbove, text = '✨', style = label.style_label_down, color = #800080, textcolor = #FFFFFF, size = size.huge, tooltip = 'Pushya Nakshatra', xloc = xloc.bar_time))
            if showVerticalLines
                line newLine = line.new(bar_index, low, bar_index, high, color = pushyaLineColor, width = lineWidth, extend = extend.both)
                array.push(eventLines, newLine)
        pushyaLabelIdx := pushyaLabelIdx + 1

if showEclipses and eclipseLabelIdx < array.size(eclipseDates)
    while eclipseLabelIdx < array.size(eclipseDates) and array.get(eclipseDates, eclipseLabelIdx) <= time
        if time >= array.get(eclipseDates, eclipseLabelIdx) and time[1] < array.get(eclipseDates, eclipseLabelIdx)
            array.push(eventLabels, label.new(x = time, y = yPosAbove, text = 'ECL', style = label.style_label_down, color = #FFA500, textcolor = #FFFFFF, size = size.normal, tooltip = 'Eclipse', xloc = xloc.bar_time))
            if showVerticalLines
                line newLine = line.new(bar_index, low, bar_index, high, color = eclipseLineColor, width = lineWidth, extend = extend.both)
                array.push(eventLines, newLine)
        eclipseLabelIdx := eclipseLabelIdx + 1

if showSolsticesEquinoxes and solsticeEquinoxLabelIdx < array.size(solsticeEquinoxDates)
    while solsticeEquinoxLabelIdx < array.size(solsticeEquinoxDates) and array.get(solsticeEquinoxDates, solsticeEquinoxLabelIdx) <= time
        if time >= array.get(solsticeEquinoxDates, solsticeEquinoxLabelIdx) and time[1] < array.get(solsticeEquinoxDates, solsticeEquinoxLabelIdx)
            array.push(eventLabels, label.new(x = time, y = yPosAbove, text = 'S/E', style = label.style_label_down, color = #FFFF00, textcolor = #000000, size = size.normal, tooltip = 'Solstice/Equinox', xloc = xloc.bar_time))
            if showVerticalLines
                line newLine = line.new(bar_index, low, bar_index, high, color = eclipseLineColor, width = lineWidth, extend = extend.both)
                array.push(eventLines, newLine)
        solsticeEquinoxLabelIdx := solsticeEquinoxLabelIdx + 1

if array.size(eventLabels) > max_drawings
    label.delete(array.shift(eventLabels))
if array.size(eventLines) > max_drawings
    line.delete(array.shift(eventLines))

// --- RSI Crossover Lines and Labels ---
var line rsiHighLine = na
var line rsiLowLine = na
var label rsiHighLabel = na
var label rsiLowLabel = na

if rsiCrossover
    // Delete old lines and labels
    line.delete(rsiHighLine)
    line.delete(rsiLowLine)
    label.delete(rsiHighLabel)
    label.delete(rsiLowLabel)

    // Create new lines and labels if the feature is enabled
    if showRsiCrossoverLines
        rsiHighLine := line.new(bar_index, high, bar_index + 1, high, extend = extend.right, color = pdhlColor, width = 1, style = line.style_dotted)
        rsiLowLine := line.new(bar_index, low, bar_index + 1, low, extend = extend.right, color = pdhlColor, width = 1, style = line.style_dotted)
        rsiHighLabel := label.new(time + 86400000, high, 'RSI H: ' + str.tostring(high, format.mintick), style = label.style_none, textcolor = pdhlColor, xloc = xloc.bar_time)
        rsiLowLabel := label.new(time + 86400000, low, 'RSI L: ' + str.tostring(low, format.mintick), style = label.style_none, textcolor = pdhlColor, xloc = xloc.bar_time)

// Also delete if the user turns off the feature
if not showRsiCrossoverLines
    line.delete(rsiHighLine)
    line.delete(rsiLowLine)
    label.delete(rsiHighLabel)
    label.delete(rsiLowLabel)

// --- Previous Day High/Low ---
var line pdhLine = na
var line pdlLine = na
var label pdhLabel = na
var label pdlLabel = na
isNewDay = ta.change(time('D')) != 0

// --- Day Separator ---
var line daySeparatorLine = na
if isNewDay and showDaySeparator
    line.delete(daySeparatorLine)
    daySeparatorLine := line.new(bar_index, low, bar_index, high, extend = extend.both, color = separatorColor, style = separatorStyle, width = separatorWidth)

// --- Opening Range High/Low ---
var line orhLine = na
var line orlLine = na
var label orhLabel = na
var label orlLabel = na

var float openingRangeHigh = na
var float openingRangeLow = na
var float openingRangeOpen = na
var int openingRangeEndTime = na
var bool range_was_set = false

durationMs = switch openingRangeDuration
    '15 min' => 15 * 60 * 1000
    '30 min' => 30 * 60 * 1000
    '1 Hour' => 60 * 60 * 1000
    '75 Min' => 75 * 60 * 1000
    '2 Hour' => 120 * 60 * 1000
    => 15 * 60 * 1000 // Default

if isNewDay
    openingRangeEndTime := time + durationMs
    openingRangeHigh := high
    openingRangeLow := low
    openingRangeOpen := open
    range_was_set := false
    // Delete previous day's lines and labels
    line.delete(orhLine)
    line.delete(orlLine)
    label.delete(orhLabel)
    label.delete(orlLabel)

if time < openingRangeEndTime and not na(openingRangeHigh)
    openingRangeHigh := math.max(openingRangeHigh, high)
    openingRangeLow := math.min(openingRangeLow, low)

// Draw the lines exactly once after the range ends
if time >= openingRangeEndTime and not range_was_set and showOpeningRange
    range_was_set := true
    orhLine := line.new(bar_index, openingRangeHigh, bar_index + 1, openingRangeHigh, extend = extend.right, color = openingRangeColor, width = openingRangeWidth, style = line.style_dashed)
    orlLine := line.new(bar_index, openingRangeLow, bar_index + 1, openingRangeLow, extend = extend.right, color = openingRangeColor, width = openingRangeWidth, style = line.style_dashed)
    orhLabel := label.new(time + 86400000, openingRangeHigh, 'ORH: ' + str.tostring(openingRangeHigh, format.mintick), style = label.style_none, textcolor = openingRangeColor, xloc = xloc.bar_time)
    orlLabel := label.new(time + 86400000, openingRangeLow, 'ORL: ' + str.tostring(openingRangeLow, format.mintick), style = label.style_none, textcolor = openingRangeColor, xloc = xloc.bar_time)

    // Check for Open = High/Low condition for the first 15 mins
    if openingRangeDuration == '15 min'
        if openingRangeOpen == openingRangeHigh
            label.new(bar_index, high, 'Open = High (Bearish)\n*', yloc = yloc.abovebar, style = label.style_none, textcolor = color.red, size = size.normal)
        if openingRangeOpen == openingRangeLow
            label.new(bar_index, low, 'Open = Low (Bullish)\n*', yloc = yloc.belowbar, style = label.style_none, textcolor = color.green, size = size.normal)


if isNewDay and showPDHL
    pdh = request.security(syminfo.tickerid, 'D', high[1])
    pdl = request.security(syminfo.tickerid, 'D', low[1])

    // Delete old lines and labels
    line.delete(pdhLine)
    line.delete(pdlLine)
    label.delete(pdhLabel)
    label.delete(pdlLabel)

    // Create new lines and labels
    pdhLine := line.new(bar_index, pdh, bar_index + 1, pdh, extend = extend.right, color = pdhlColor, width = pdhlWidth, style = line.style_dashed)
    pdlLine := line.new(bar_index, pdl, bar_index + 1, pdl, extend = extend.right, color = pdhlColor, width = pdhlWidth, style = line.style_dashed)
    pdhLabel := label.new(time + 86400000, pdh, 'PDH: ' + str.tostring(pdh, format.mintick), style = label.style_none, textcolor = pdhlColor, xloc = xloc.bar_time)
    pdlLabel := label.new(time + 86400000, pdl, 'PDL: ' + str.tostring(pdl, format.mintick), style = label.style_none, textcolor = pdhlColor, xloc = xloc.bar_time)

// --- Info Table ---
var table trendTable = table.new(trendTablePosition, 2, 4, border_width = 2, border_color = tableBorderColor)
var table priceTable = table.new(priceTablePosition, 2, 6, border_width = 2, border_color = tableBorderColor)
var table ultimateSignalTable = table.new(ultimateSignalTablePosition, 2, 7, border_width = 2, border_color = tableBorderColor)
var table rsiSignalTable = table.new(rsiSignalTablePosition, 2, 5, border_width = 2, border_color = tableBorderColor)

if showRsiSignalTable
    table.clear(rsiSignalTable, 0, 0, 1, 4)
    table.set_bgcolor(rsiSignalTable, tableBgColor)
    table.set_border_width(rsiSignalTable, 2)

    var string rsiSignalType = "Neutral"
    var float rsiEntryPoint = na

    if rsiCrossover
        rsiSignalType := "Upcross"
        rsiEntryPoint := close
    if rsiCrossunder
        rsiSignalType := "Undercross"
        rsiEntryPoint := close

    rsiSignalColor = rsiSignalType == "Upcross" ? color.green : rsiSignalType == "Undercross" ? color.red : color.white
    distanceFromRsiAlert = close - rsiEntryPoint
    percentDistanceFromRsiAlert = (distanceFromRsiAlert / rsiEntryPoint) * 100

    table.cell(rsiSignalTable, 0, 0, 'RSI Signal', text_halign = 'left', text_size = size.normal, text_color = #1414e3)
    table.cell(rsiSignalTable, 1, 0, rsiSignalType, text_halign = 'center', text_size = size.normal, text_color = rsiSignalColor)

    table.cell(rsiSignalTable, 0, 1, 'Entry Point', text_halign = 'left', text_size = size.normal, text_color = #1414e3)
    table.cell(rsiSignalTable, 1, 1, str.tostring(rsiEntryPoint, '#.##'), text_halign = 'center', text_size = size.normal, text_color = color.black)

    table.cell(rsiSignalTable, 0, 2, 'Distance', text_halign = 'left', text_size = size.normal, text_color = #1414e3)
    table.cell(rsiSignalTable, 1, 2, str.tostring(distanceFromRsiAlert, '#.##'), text_halign = 'center', text_size = size.normal, text_color = color.black)

    table.cell(rsiSignalTable, 0, 3, '% Distance', text_halign = 'left', text_size = size.normal, text_color = #1414e3)
    table.cell(rsiSignalTable, 1, 3, str.tostring(percentDistanceFromRsiAlert, '#.##') + '%', text_halign = 'center', text_size = size.normal, text_color = color.black)

    table.cell(rsiSignalTable, 0, 4, 'Current RSI', text_halign = 'left', text_size = size.normal, text_color = #1414e3)
    table.cell(rsiSignalTable, 1, 4, str.tostring(smoothedRsi, '#.##'), text_halign = 'center', text_size = size.normal, text_color = color.black)


if showTrendTable
    // Clear and set up Trend Table
    table.clear(trendTable, 0, 0, 1, 3)
    table.set_bgcolor(trendTable, tableBgColor)
    table.set_border_width(trendTable, 2)
    nextAmavasya = array.get(amavasyaDates, amavasyaIdx)
    nextPurnima = array.get(purnimaDates, purnimaIdx)
    nextEventName = ''
    daysToNextEvent = 0.0
    if nextAmavasya < nextPurnima
        nextEventName := 'Amavasya'
        daysToNextEvent := (nextAmavasya - time) / (1000 * 60 * 60 * 24)
    else
        nextEventName := 'Purnima'
        daysToNextEvent := (nextPurnima - time) / (1000 * 60 * 60 * 24)
    bullishBearishEmoji = isBullishPhase ? '🟢' : '🔴'
    dayName = str.tostring(dayofweek)
    nextEventColor = nextEventName == 'Purnima' ? color.green : color.red
    table.cell(trendTable, 0, 0, 'Current Trend', text_halign = 'left', text_size = size.normal, text_color = #1414e3)
    table.cell(trendTable, 1, 0, bullishBearishEmoji, text_halign = 'center', text_size = size.normal, text_color = color.white)
    table.cell(trendTable, 0, 1, 'Next Event', text_halign = 'left', text_size = size.normal, text_color = #1414e3)
    table.cell(trendTable, 1, 1, nextEventName, text_halign = 'center', text_size = size.normal, text_color = nextEventColor)
    table.cell(trendTable, 0, 2, 'Days to Event', text_halign = 'left', text_size = size.normal, text_color = #1414e3)
    table.cell(trendTable, 1, 2, str.tostring(daysToNextEvent, '#.#'), text_halign = 'center', text_size = size.normal, text_color = color.black)

if showPriceTable
    // Clear and set up Price Table
    table.clear(priceTable, 0, 0, 1, 5)
    table.set_bgcolor(priceTable, tableBgColor)
    table.set_border_width(priceTable, 2)

    // Populate Price Table
    table.cell(priceTable, 0, 0, 'Close', text_halign = 'left', text_size = size.normal, text_color = #1414e3)
    table.cell(priceTable, 1, 0, str.tostring(close, format.mintick), text_halign = 'center', text_size = size.normal)
    table.cell(priceTable, 0, 1, 'VWAP', text_halign = 'left', text_size = size.normal, text_color = #1414e3)
    table.cell(priceTable, 1, 1, str.tostring(vwapValue, format.mintick), text_halign = 'center', text_size = size.normal)

    proximityValue = close - vwapValue

    // Proximity flashing logic
    proximityBgColor = if bar_index % 2 == 0
        if proximityValue >= 1 and proximityValue <= 25
            color.red
        else if proximityValue <= -1 and proximityValue >= -25
            color.green
        else if proximityValue == 0
            color.orange
        else
            tableBgColor
    else
        tableBgColor

    table.cell(priceTable, 0, 2, 'Proximity', text_halign = 'left', text_size = size.normal, text_color = #1414e3, bgcolor = proximityBgColor)
    table.cell(priceTable, 1, 2, str.tostring(proximityValue, format.mintick), text_halign = 'center', text_size = size.normal, bgcolor = proximityBgColor)

    // Add Smoothed RSI to Price Table
    rsiText = ''
    rsiColor = color.white

    if smoothedRsi > 60
        rsiText := str.tostring(smoothedRsi, '#.##')
        rsiColor := color.green
    else if smoothedRsi < 40
        rsiText := str.tostring(smoothedRsi, '#.##')
        rsiColor := color.red
    else
        rsiText := 'No Trade Zone'

    table.cell(priceTable, 0, 3, 'Smoothed RSI', text_halign = 'left', text_size = size.normal, text_color = #1414e3)
    table.cell(priceTable, 1, 3, rsiText, text_halign = 'center', text_size = size.normal, text_color = rsiColor)

    // Add RSI Signal Type to Price Table
    rsiSignalText = rsiCrossover ? "Blue" : "White"
    rsiSignalColor = rsiCrossover ? color.blue : color.white

    table.cell(priceTable, 0, 4, 'RSI Signal Type', text_halign = 'left', text_size = size.normal, text_color = #1414e3)
    table.cell(priceTable, 1, 4, rsiSignalText, text_halign = 'center', text_size = size.normal, text_color = rsiSignalColor)

// --- Global ATR Calculation for Consistency ---
atrValue = ta.atr(14)

if showUltimateSignalTable and useUltimateCrossover
    // Populate Ultimate Signal Table
    table.clear(ultimateSignalTable, 0, 0, 1, 5)
    table.set_bgcolor(ultimateSignalTable, tableBgColor)
    table.set_border_width(ultimateSignalTable, 2)

    var string ultimateSignalRecommendation = "Neutral"
    var float lastAlertPrice = na
    if ultimateBuySignal
        ultimateSignalRecommendation := "Buy"
        lastAlertPrice := close
    if ultimateSellSignal
        ultimateSignalRecommendation := "Sell"
        lastAlertPrice := close

    signalColor = ultimateSignalRecommendation == "Buy" ? color.green : ultimateSignalRecommendation == "Sell" ? color.red : color.white
    distanceFromMa = close - ultimateMa

    isProximity = useUltimateCrossover and colorProximityCandles and math.abs(close - ultimateMa) <= (atrValue * proximityAtrMultiplier)
    tradeStatusText = isProximity ? "Get Ready to Trade" : "Wait Patiently......."
    tradeStatusColor = if isProximity
        if close > ultimateMa
            color.green
        else
            color.red
    else
        color.black

    table.cell(ultimateSignalTable, 0, 0, 'Ultimate Signal', text_halign = 'left', text_size = size.normal, text_color = #1414e3)
    table.cell(ultimateSignalTable, 1, 0, ultimateSignalRecommendation, text_halign = 'center', text_size = size.normal, text_color = signalColor)

    bestEntryPointColor = ultimateSignalRecommendation == "Buy" ? color.green : ultimateSignalRecommendation == "Sell" ? color.red : color.white
    table.cell(ultimateSignalTable, 0, 1, 'Best Entry Point', text_halign = 'left', text_size = size.normal, text_color = #1414e3)
    table.cell(ultimateSignalTable, 1, 1, str.tostring(ultimateMa, '#.##'), text_halign = 'center', text_size = size.normal, text_color = bestEntryPointColor)

    table.cell(ultimateSignalTable, 0, 2, 'Distance from MA', text_halign = 'left', text_size = size.normal, text_color = #1414e3)
    table.cell(ultimateSignalTable, 1, 2, str.tostring(distanceFromMa, '#.##'), text_halign = 'center', text_size = size.normal, text_color = color.black)
    table.cell(ultimateSignalTable, 0, 3, 'Last Alert Price', text_halign = 'left', text_size = size.normal, text_color = #1414e3)
    table.cell(ultimateSignalTable, 1, 3, str.tostring(lastAlertPrice, '#.##'), text_halign = 'center', text_size = size.normal, text_color = color.black)
    table.cell(ultimateSignalTable, 0, 4, 'ATR', text_halign = 'left', text_size = size.normal, text_color = #1414e3)
    table.cell(ultimateSignalTable, 1, 4, str.tostring(atrValue, '#.##'), text_halign = 'center', text_size = size.normal, text_color = color.black)
    table.cell(ultimateSignalTable, 0, 5, 'Trade Status', text_halign = 'left', text_size = size.normal, text_color = #1414e3)
    table.cell(ultimateSignalTable, 1, 5, tradeStatusText, text_halign = 'center', text_size = size.normal, text_color = tradeStatusColor)

    distanceFromLastAlert = close - lastAlertPrice
    table.cell(ultimateSignalTable, 0, 6, 'Dist from Alert', text_halign = 'left', text_size = size.normal, text_color = #1414e3)
    table.cell(ultimateSignalTable, 1, 6, str.tostring(distanceFromLastAlert, '#.##'), text_halign = 'center', text_size = size.normal, text_color = color.black)

// --- Bar Coloring Block ---
// @description Consolidates all bar coloring logic based on priority.

// High Volume Condition
volumeSma = ta.sma(volume, 10)
highVolume = volume > volumeSma * 5

// Flashing Signal Alert Condition
var int barsSinceSignal = na
if buySignal or sellSignal
    barsSinceSignal := 0
if not na(barsSinceSignal)
    barsSinceSignal := barsSinceSignal + 1
flashSignalCondition = not na(barsSinceSignal) and barsSinceSignal <= 3 and bar_index % 2 == 0

// Determine final color with priority (Proximity > RSI > Ultimate > Flash > High Volume)
proximityRange = atrValue * proximityAtrMultiplier
color finalBarColor = if useUltimateCrossover and colorProximityCandles and math.abs(close - ultimateMa) <= proximityRange
    color.new(#f0d900, 50)
else if useUltimateCrossover and rsiCrossover
    color.blue
else if useUltimateCrossover and rsiCrossunder
    color.purple
else if useUltimateCrossover and colorUltimateCandles
    close > ultimateMa ? ultimateBullColor : ultimateBearColor
else if showRSICrossover and rsiCrossover
    color.new(#00008B, 40)
else if showRsiCrossunder and rsiCrossunder
    rsiCrossunderColor
else if flashSignalCondition
    color.new(color.yellow, 50)
else if colorHighVolume and highVolume
    color.new(#FFA500, 50)
else
    na

barcolor(finalBarColor)

// --- More Visible RSI Crossover Highlighting ---
plotshape(showRSICrossover and rsiCrossover, title="RSI Upcross Highlight", text='⭐', style=shape.labelup, location=location.belowbar, color=color.new(color.blue, 50), textcolor=color.white, size=size.small)
plotshape(showRsiCrossunder and rsiCrossunder, title="RSI Downcross Highlight", text='⭐', style=shape.labeldown, location=location.abovebar, color=color.new(color.purple, 50), textcolor=color.white, size=size.small)

// --- RSI Crossover Shapes for Ultimate Signal ---
if useUltimateCrossover and rsiCrossover
    label.new(bar_index, na, '📈 RSI > ' + str.tostring(rsiCrossoverThreshold), yloc=yloc.belowbar, style=label.style_label_up, color=color.new(color.white, 0), textcolor=color.black, size=size.small)

if useUltimateCrossover and rsiCrossunder
    label.new(bar_index, na, '📉 RSI < ' + str.tostring(rsiCrossunderThreshold), yloc=yloc.abovebar, style=label.style_label_down, color=color.new(color.white, 0), textcolor=color.black, size=size.small)

plotshape(useUltimateCrossover and rsiCrossover, 'RSI Buy Signal', style=shape.arrowup, location=location.belowbar, color=color.new(color.blue, 0), size=size.small)
plotshape(useUltimateCrossover and rsiCrossunder, 'RSI Sell Signal', style=shape.arrowdown, location=location.abovebar, color=color.new(color.purple, 0), size=size.small)

// --- END --- Plotting Block

// --- START --- Alerts Block
// @description Defines alert conditions for buy and sell signals.

// --- Alert Conditions ---

alertcondition(buySignal and showBuySellAlerts, title = 'Buy Signal', message = 'Buy Signal: Close crossed above Smoothed VWAP in Bullish Phase')
alertcondition(sellSignal and showBuySellAlerts, title = 'Sell Signal', message = 'Sell Signal: Close crossed below Smoothed VWAP in Bearish Phase')
alertcondition(vwapTurnUp and isBullishPhase and showReversalAlerts, title = 'Bullish Reversal', message = 'Bullish Reversal: Smoothed VWAP turned up in Bullish Phase')
alertcondition(vwapTurnDown and isBearishPhase and showReversalAlerts, title = 'Bearish Reversal', message = 'Bearish Reversal: Smoothed VWAP turned down in Bearish Phase')
alertcondition(rsiCrossover and showRsiCrossoverAlerts, title = 'RSI Upcross Above Upper Threshold', message = 'Alert: Smoothed RSI crossed above the configured upper threshold')
alertcondition(rsiCrossunder and showRsiCrossoverAlerts, title = 'RSI Cross Below Lower Threshold', message = 'Alert: Smoothed RSI crossed below the configured lower threshold')
alertcondition(useUltimateCrossover and ultimateBuySignal and showUltimateCrossoverAlerts, title = 'Ultimate Buy Signal', message = 'Ultimate Buy: Close crossed above the selected Moving Average')
alertcondition(useUltimateCrossover and ultimateSellSignal and showUltimateCrossoverAlerts, title = 'Ultimate Sell Signal', message = 'Ultimate Sell: Close crossed below the selected Moving Average')

// --- START --- Regression Channel Block
// @description Calculates and plots a regression channel based on Pearson's R.
var line upper = na
var line lower = na

calcSlope(source, length) =>
    max_bars_back(source, 5000)
    if length <= 1
        [float(na), float(na), float(na)]
    else
        sumX = 0.0
        sumY = 0.0
        sumXSqr = 0.0
        sumXY = 0.0
        for i = 0 to length - 1 by 1
            val = source[i]
            per = i + 1.0
            sumX += per
            sumY += val
            sumXSqr += per * per
            sumXY += val * per
        slope = (length * sumXY - sumX * sumY) / (length * sumXSqr - sumX * sumX)
        average = sumY / length
        intercept = average - slope * sumX / length + slope
        [slope, average, intercept]

calcDev(source, length, slope, average, intercept) =>
    upDev = 0.0
    dnDev = 0.0
    stdDevAcc = 0.0
    dsxx = 0.0
    dsyy = 0.0
    dsxy = 0.0
    periods = length - 1
    daY = intercept + slope * periods / 2
    val = intercept
    for j = 0 to periods by 1
        price = high[j] - val
        if price > upDev
            upDev := price
        price := val - low[j]
        if price > dnDev
            dnDev := price
        price := source[j]
        dxt = price - average
        dyt = val - daY
        price -= val
        stdDevAcc += price * price
        dsxx += dxt * dxt
        dsyy += dyt * dyt
        dsxy += dxt * dyt
        val += slope
    stdDev = math.sqrt(stdDevAcc / (periods == 0 ? 1 : periods))
    pearsonR = dsxx == 0 or dsyy == 0 ? 0 : dsxy / math.sqrt(dsxx * dsyy)
    [stdDev, pearsonR, upDev, dnDev]

[s, a, i] = calcSlope(sourceInput, lengthInput)

if showRegressionChannel
    extendStyle = if extendLeftInput and extendRightInput
        extend.both
    else if extendLeftInput
        extend.left
    else if extendRightInput
        extend.right
    else
        extend.none

    startPrice = i + s * (lengthInput - 1)
    endPrice = i
    var line baseLine = na
    if na(baseLine) and not na(startPrice)
        baseLine := line.new(bar_index - lengthInput + 1, startPrice, bar_index, endPrice, width=1, extend=extendStyle, color=color.new(colorLower, 0))
    else
        line.set_xy1(baseLine, bar_index - lengthInput + 1, startPrice)
        line.set_xy2(baseLine, bar_index, endPrice)

    [stdDev, pearsonR, upDev, dnDev] = calcDev(sourceInput, lengthInput, s, a, i)
    upperStartPrice = startPrice + (useUpperDevInput ? upperMultInput * stdDev : upDev)
    upperEndPrice = endPrice + (useUpperDevInput ? upperMultInput * stdDev : upDev)
    lowerStartPrice = startPrice + (useLowerDevInput ? -lowerMultInput * stdDev : -dnDev)
    lowerEndPrice = endPrice + (useLowerDevInput ? -lowerMultInput * stdDev : -dnDev)
    if na(upper) and not na(upperStartPrice)
        upper := line.new(bar_index - lengthInput + 1, upperStartPrice, bar_index, upperEndPrice, width=1, extend=extendStyle, color=color.new(colorUpper, 0))
    else
        line.set_xy1(upper, bar_index - lengthInput + 1, upperStartPrice)
        line.set_xy2(upper, bar_index, upperEndPrice)
    if na(lower) and not na(lowerStartPrice)
        lower := line.new(bar_index - lengthInput + 1, lowerStartPrice, bar_index, lowerEndPrice, width=1, extend=extendStyle, color=color.new(colorUpper, 0))
    else
        line.set_xy1(lower, bar_index - lengthInput + 1, lowerStartPrice)
        line.set_xy2(lower, bar_index, lowerEndPrice)
    linefill.new(upper, baseLine, color = colorUpper)
    linefill.new(baseLine, lower, color = colorLower)

    // Pearson's R
    var label r = na
    label.delete(r[1])
    if showPearsonInput and not na(pearsonR)
        r := label.new(bar_index - lengthInput + 1, lowerStartPrice, str.tostring(pearsonR, "#.################"), color = color.new(color.white, 100), textcolor=color.new(colorUpper, 0), size=size.normal, style=label.style_label_up)

// --- END --- Regression Channel Block

// --- Regression Channel Alerts ---
float trend = showRegressionChannel ? math.sign(s) : na
alertcondition(showRegressionChannel and (sourceInput > line.get_price(upper, bar_index) or sourceInput < line.get_price(lower, bar_index)), title='Regression Channel Exited', message="The price movement has exited Regression Channel's bounds")
alertcondition(showRegressionChannel and trend[1] >= 0 and trend < 0, title='Switched to Uptrend',   message='The Regression Channel trend switched from Downtrend to Uptrend')
alertcondition(showRegressionChannel and trend[1] <= 0 and trend > 0, title='Switched to Downtrend', message='The Regression Channel trend switched from Uptrend to Downtrend')

// --- END --- Alerts Block
