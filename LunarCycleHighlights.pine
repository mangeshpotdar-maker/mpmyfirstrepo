//@version=6
indicator("Lunar Cycle Highlights", overlay=true, max_lines_count=500, max_labels_count=500)
var G_LUNAR = "Lunar Events"
showAmavasya = input.bool(true, "Show Amavasya 🌑", group = G_LUNAR, inline = "lunar")
showPurnima = input.bool(true, "Show Purnima 🌕", group = G_LUNAR, inline = "lunar")
showEmojis = input.bool(true, "Show Emojis in Labels", group = G_LUNAR)
showEventBeginLabels = input.bool(false, "Show '... begins' Labels", tooltip="Shows a label for the exact start of the event. The main labels still appear.", group=G_LUNAR)

var G_AMAVASYA = "Amavasya Display"
amavasyaLabelPos = input.string("top", "Label Position", options=["top", "bottom"], group = G_AMAVASYA)
amavasyaColor = input.color(color.new(color.red, 0), "Color", group = G_AMAVASYA)
var G_PURNIMA = "Purnima Display"
purnimaColor = input.color(color.new(color.green, 0), "Color", group = G_PURNIMA)
var G_PANEL = "Info Panel"
showInfoPanel = input.bool(true, "Show Phase Info Panel", group = G_PANEL)
var G_VWAP = "VWAP"
showVWAP = input.bool(true, "Show VWAP", group = G_VWAP)
vwapColor = input.color(color.new(color.blue, 0), "VWAP Color", group = G_VWAP)
vwapWidth = input.int(2, "VWAP Line Width", minval=1, maxval=5, group = G_VWAP)
showSmoothedVWAP = input.bool(true, "Show Smoothed VWAP", group = G_VWAP)
smoothedVWAPLength = input.int(10, "Smoothed VWAP Length", minval=1, group = G_VWAP)
smoothedVWAPColor = input.color(color.new(color.orange, 0), "Smoothed VWAP Color", group = G_VWAP)
var G_SIGNALS = "Crossover Signals"
showCrossoverSignals = input.bool(true, "Show Crossover Signals", group = G_SIGNALS)
buySignalColor = input.color(color.new(color.green, 0), "Buy Signal Color", group = G_SIGNALS)
sellSignalColor = input.color(color.new(color.red, 0), "Sell Signal Color", group = G_SIGNALS)
showSignalText = input.bool(true, "Show 'Buy'/'Sell' Text", group = G_SIGNALS)
var G_BG = "Background Coloring"
bullishColor = input.color(color.new(color.green, 90), "Bullish Color", group = G_BG)
bearishColor = input.color(color.new(color.red, 90), "Bearish Color", group = G_BG)

var amavasyaDates = array.from(timestamp("Asia/Kolkata", 2024, 1, 11, 5, 57), timestamp("Asia/Kolkata", 2024, 2, 9, 16, 0), timestamp("Asia/Kolkata", 2024, 3, 10, 14, 1), timestamp("Asia/Kolkata", 2024, 4, 8, 23, 19), timestamp("Asia/Kolkata", 2024, 5, 8, 8, 57), timestamp("Asia/Kolkata", 2024, 6, 6, 17, 38), timestamp("Asia/Kolkata", 2024, 7, 6, 6, 0), timestamp("Asia/Kolkata", 2024, 8, 4, 19, 14), timestamp("Asia/Kolkata", 2024, 9, 3, 9, 26), timestamp("Asia/Kolkata", 2024, 10, 2, 23, 25), timestamp("Asia/Kolkata", 2024, 11, 1, 12, 3), timestamp("Asia/Kolkata", 2024, 12, 1, 0, 32), timestamp("Asia/Kolkata", 2025, 1, 29, 9, 54), timestamp("Asia/Kolkata", 2025, 2, 28, 15, 5), timestamp("Asia/Kolkata", 2025, 3, 29, 18, 43), timestamp("Asia/Kolkata", 2025, 4, 28, 22, 20), timestamp("Asia/Kolkata", 2025, 5, 28, 2, 37), timestamp("Asia/Kolkata", 2025, 6, 26, 8, 1), timestamp("Asia/Kolkata", 2025, 7, 25, 15, 12), timestamp("Asia/Kolkata", 2025, 8, 24, 1, 51), timestamp("Asia/Kolkata", 2025, 9, 22, 16, 1), timestamp("Asia/Kolkata", 2025, 10, 22, 8, 25), timestamp("Asia/Kolkata", 2025, 11, 21, 3, 30), timestamp("Asia/Kolkata", 2025, 12, 20, 22, 20), timestamp("Asia/Kolkata", 2026, 1, 19, 15, 8), timestamp("Asia/Kolkata", 2026, 2, 18, 4, 39), timestamp("Asia/Kolkata", 2026, 3, 19, 14, 57), timestamp("Asia/Kolkata", 2026, 4, 17, 23, 13), timestamp("Asia/Kolkata", 2026, 5, 17, 6, 3), timestamp("Asia/Kolkata", 2026, 6, 15, 13, 28), timestamp("Asia/Kolkata", 2026, 7, 14, 22, 21), timestamp("Asia/Kolkata", 2026, 8, 13, 9, 13), timestamp("Asia/Kolkata", 2026, 9, 11, 22, 9), timestamp("Asia/Kolkata", 2026, 10, 11, 13, 1), timestamp("Asia/Kolkata", 2026, 11, 10, 8, 0), timestamp("Asia/Kolkata", 2026, 12, 10, 4, 28))
var purnimaDates = array.from(timestamp("Asia/Kolkata", 2024, 1, 25, 5, 54), timestamp("Asia/Kolkata", 2024, 2, 24, 18, 39), timestamp("Asia/Kolkata", 2024, 3, 25, 12, 3), timestamp("Asia/Kolkata", 2024, 4, 24, 8, 17), timestamp("Asia/Kolkata", 2024, 5, 23, 6, 47), timestamp("Asia/Kolkata", 2024, 6, 22, 7, 8), timestamp("Asia/Kolkata", 2024, 7, 21, 9, 38), timestamp("Asia/Kolkata", 2024, 8, 19, 14, 0), timestamp("Asia/Kolkata", 2024, 9, 18, 20, 34), timestamp("Asia/Kolkata", 2024, 10, 17, 5, 19), timestamp("Asia/Kolkata", 2024, 11, 15, 16, 17), timestamp("Asia/Kolkata", 2024, 12, 15, 5, 15), timestamp("Asia/Kolkata", 2025, 1, 13, 19, 24), timestamp("Asia/Kolkata", 2025, 2, 12, 9, 49), timestamp("Asia/Kolkata", 2025, 3, 13, 23, 39), timestamp("Asia/Kolkata", 2025, 4, 12, 11, 33), timestamp("Asia/Kolkata", 2025, 5, 12, 21, 14), timestamp("Asia/Kolkata", 2025, 6, 11, 5, 13), timestamp("Asia/Kolkata", 2025, 7, 10, 12, 23), timestamp("Asia/Kolkata", 2025, 8, 8, 19, 19), timestamp("Asia/Kolkata", 2025, 9, 7, 3, 5), timestamp("Asia/Kolkata", 2025, 10, 6, 12, 4), timestamp("Asia/Kolkata", 2025, 11, 4, 23, 21), timestamp("Asia/Kolkata", 2025, 12, 4, 13, 0), timestamp("Asia/Kolkata", 2026, 1, 3, 4, 14), timestamp("Asia/Kolkata", 2026, 2, 1, 20, 3), timestamp("Asia/Kolkata", 2026, 3, 3, 10, 34), timestamp("Asia/Kolkata", 2026, 4, 2, 0, 15), timestamp("Asia/Kolkata", 2026, 5, 1, 11, 22), timestamp("Asia/Kolkata", 2026, 5, 30, 20, 55), timestamp("Asia/Kolkata", 2026, 6, 29, 5, 6), timestamp("Asia/Kolkata", 2026, 7, 28, 12, 32), timestamp("Asia/Kolkata", 2026, 8, 26, 20, 9), timestamp("Asia/Kolkata", 2026, 9, 25, 4, 49), timestamp("Asia/Kolkata", 2026, 10, 24, 15, 7), timestamp("Asia/Kolkata", 2026, 11, 23, 3, 27), timestamp("Asia/Kolkata", 2026, 12, 22, 17, 7))
f_is_event_start(date_array, array_idx_var) =>
    is_first = false
    current_idx = array_idx_var
    if array.size(date_array) > current_idx
        event_time = array.get(date_array, current_idx)
        if time >= event_time and nz(time[1]) < event_time
            is_first := true
            current_idx += 1
    [is_first, current_idx]
var ama_idx = 0
var poo_idx = 0
isAmaFirst = false
isPooFirst = false
if showAmavasya
    [isAmaFirst_val, ama_idx_val] = f_is_event_start(amavasyaDates, ama_idx)
    isAmaFirst := isAmaFirst_val
    ama_idx := ama_idx_val
if showPurnima
    [isPooFirst_val, poo_idx_val] = f_is_event_start(purnimaDates, poo_idx)
    isPooFirst := isPooFirst_val
    poo_idx := poo_idx_val
lookback = 5000
highestHigh = ta.highest(high, lookback)
lowestLow = ta.lowest(low, lookback)
atr = ta.atr(14)

var float monthlyHigh = high
var float prevMonthlyHigh = na
isNewMonth = ta.change(month) != 0

if isNewMonth
    prevMonthlyHigh := nz(monthlyHigh[1], high)
    monthlyHigh := high
else
    monthlyHigh := math.max(nz(monthlyHigh[1], high), high)

f_draw_event(_time, _label, _emoji, _color, _isFirst, _y_price) =>
    if _isFirst
        _labstyle = label.style_label_down
        _emojiText = showEmojis ? " " + _emoji : ""
        label.new(x=_time, y=_y_price, text=_label + _emojiText, xloc=xloc.bar_time, yloc=yloc.price, style=_labstyle, color=_color, textcolor=color.white)

y_pos_for_event = prevMonthlyHigh + atr

f_draw_event(time, "Amavasya", "🌑", amavasyaColor, isAmaFirst, y_pos_for_event)
f_draw_event(time, "Purnima", "🌕", purnimaColor, isPooFirst, y_pos_for_event)
var int lastP_time = na
var int lastA_time = na
if isPooFirst
    lastP_time := array.get(purnimaDates, poo_idx - 1)
if isAmaFirst
    lastA_time := array.get(amavasyaDates, ama_idx - 1)
inBullish = nz(lastP_time, 0) > nz(lastA_time, 0)

// Use EMA as a fallback for VWAP on charts without volume
// On symbols without volume data, the built-in 'volume' variable returns 'na'.
use_vwap = not na(volume)
vwap_calc = ta.vwap(hlc3)
ema_fallback = ta.ema(close, 20)
vwapValue = use_vwap ? vwap_calc : ema_fallback
smoothedVWAPValue = ta.ema(vwapValue, smoothedVWAPLength)

plot(showVWAP ? vwapValue : na, "VWAP / EMA Fallback", color=vwapColor, linewidth=vwapWidth)
plot(showSmoothedVWAP ? smoothedVWAPValue : na, "Smoothed VWAP", color=smoothedVWAPColor, linewidth=vwapWidth)
buySignal = ta.crossover(close, smoothedVWAPValue) and inBullish
sellSignal = ta.crossunder(close, smoothedVWAPValue) and not inBullish

// Plot signals with text if enabled. Separate plotshape calls are needed because the 'text' argument must be a constant string.
plotshape(showCrossoverSignals and showSignalText and buySignal, text='Buy', style=shape.triangleup, location=location.belowbar, color=buySignalColor, size=size.small)
plotshape(showCrossoverSignals and showSignalText and sellSignal, text='Sell', style=shape.triangledown, location=location.abovebar, color=sellSignalColor, size=size.small)

// Plot signals without text if disabled
plotshape(showCrossoverSignals and not showSignalText and buySignal, style=shape.triangleup, location=location.belowbar, color=buySignalColor, size=size.small)
plotshape(showCrossoverSignals and not showSignalText and sellSignal, style=shape.triangledown, location=location.abovebar, color=sellSignalColor, size=size.small)

alertcondition(buySignal, title="Buy Signal", message="VWAP Crossover Buy Signal")
alertcondition(sellSignal, title="Sell Signal", message="VWAP Crossover Sell Signal")

// -----------------------------------------------------------------------------
// === Amavasya Breakout Section ===
// -----------------------------------------------------------------------------

bgcolor(inBullish ? bullishColor : bearishColor)

var label infoPanel = na

f_next_event_time(date_array, idx) =>
    idx < array.size(date_array) ? array.get(date_array, idx) : na

fmtDate(_t) => na(_t) ? "N/A" : str.format("{0,date,dd MMM yyyy HH:mm}", _t)

var int lastEventTime = na
if isAmaFirst or isPooFirst
    lastEventTime := time

if showInfoPanel and barstate.islast
    nextAma = f_next_event_time(amavasyaDates, ama_idx)
    nextPoo = f_next_event_time(purnimaDates, poo_idx)
    nextText = ""
    if na(nextAma) and na(nextPoo)
        nextText := "No future events in data"
    else if na(nextPoo) or (nextAma < nextPoo)
        nextText := "Next Amavasya: " + fmtDate(nextAma)
    else
        nextText := "Next Purnima: " + fmtDate(nextPoo)

    phaseName = inBullish ? "Purnima → Amavasya (Bullish half)" : "Amavasya → Purnima (Bearish half)"
    panelText = "Phase: " + phaseName + "\n" + nextText

    panelColor = inBullish ? color.new(color.green, 20) : color.new(color.red, 20)

    label.delete(infoPanel)

    infoPanel := label.new(x=bar_index, y=y_pos_for_event + atr, yloc=yloc.price,
                           text=panelText, style=label.style_label_up,
                           color=panelColor, textcolor=color.white,
                           xloc=xloc.bar_index)

// -----------------------------------------------------------------------------
// === Linear Regression Channel Section ===
// -----------------------------------------------------------------------------
lengthInput = input.int(100,      "Length", minval = 1, maxval = 5000)
sourceInput = input.source(close, "Source")

group1 = "Channel Settings"
useUpperDevInput = input.bool(true, "Upper Deviation",             inline = "Upper Deviation", group = group1)
upperMultInput   = input.float(2.0, "", active = useUpperDevInput, inline = "Upper Deviation", group = group1)
useLowerDevInput = input.bool(true, "Lower Deviation",             inline = "Lower Deviation", group = group1)
lowerMultInput   = input.float(2.0, "", active = useLowerDevInput, inline = "Lower Deviation", group = group1)

group2 = "Display Settings"
showPearsonInput = input.bool(true,  "Show Pearson's R",   group = group2)
extendLeftInput  = input.bool(false, "Extend Lines Left",  group = group2)
extendRightInput = input.bool(true,  "Extend Lines Right", group = group2)

extendStyle = switch
    extendLeftInput and extendRightInput => extend.both
    extendLeftInput => extend.left
    extendRightInput => extend.right
    => extend.none

group3 = "Color Settings"
colorUpper = input.color(color.new(color.blue, 85), "", inline = group3, group = group3)
colorLower = input.color(color.new(color.red,  85), "", inline = group3, group = group3)

calcSlope(source, length) =>
    max_bars_back(source, 5000)
    if not barstate.islast or length <= 1
        [float(na), float(na), float(na)]
    else
        sumX = 0.0
        sumY = 0.0
        sumXSqr = 0.0
        sumXY = 0.0
        for i = 0 to length - 1 by 1
            val = source[i]
            per = i + 1.0
            sumX += per
            sumY += val
            sumXSqr += per * per
            sumXY += val * per
        slope = (length * sumXY - sumX * sumY) / (length * sumXSqr - sumX * sumX)
        average = sumY / length
        intercept = average - slope * sumX / length + slope
        [slope, average, intercept]

[s, a, i] = calcSlope(sourceInput, lengthInput)
startPrice = i + s * (lengthInput - 1)
endPrice = i
var line baseLine = na
if na(baseLine) and not na(startPrice)
    baseLine := line.new(bar_index - lengthInput + 1, startPrice, bar_index, endPrice, width=1, extend=extendStyle, color=color.new(colorLower, 0))
else
    line.set_xy1(baseLine, bar_index - lengthInput + 1, startPrice)
    line.set_xy2(baseLine, bar_index, endPrice)

calcDev(source, length, slope, average, intercept) =>
    upDev = 0.0
    dnDev = 0.0
    stdDevAcc = 0.0
    dsxx = 0.0
    dsyy = 0.0
    dsxy = 0.0
    periods = length - 1
    daY = intercept + slope * periods / 2
    val = intercept
    for j = 0 to periods by 1
        price = high[j] - val
        if price > upDev
            upDev := price
        price := val - low[j]
        if price > dnDev
            dnDev := price
        price := source[j]
        dxt = price - average
        dyt = val - daY
        price -= val
        stdDevAcc += price * price
        dsxx += dxt * dxt
        dsyy += dyt * dyt
        dsxy += dxt * dyt
        val += slope
    stdDev = math.sqrt(stdDevAcc / (periods == 0 ? 1 : periods))
    pearsonR = dsxx == 0 or dsyy == 0 ? 0 : dsxy / math.sqrt(dsxx * dsyy)
    [stdDev, pearsonR, upDev, dnDev]

[stdDev, pearsonR, upDev, dnDev] = calcDev(sourceInput, lengthInput, s, a, i)
upperStartPrice = startPrice + (useUpperDevInput ? upperMultInput * stdDev : upDev)
upperEndPrice = endPrice + (useUpperDevInput ? upperMultInput * stdDev : upDev)
var line upper = na
lowerStartPrice = startPrice + (useLowerDevInput ? -lowerMultInput * stdDev : -dnDev)
lowerEndPrice = endPrice + (useLowerDevInput ? -lowerMultInput * stdDev : -dnDev)
var line lower = na
if na(upper) and not na(upperStartPrice)
    upper := line.new(bar_index - lengthInput + 1, upperStartPrice, bar_index, upperEndPrice, width=1, extend=extendStyle, color=color.new(colorUpper, 0))
else
    line.set_xy1(upper, bar_index - lengthInput + 1, upperStartPrice)
    line.set_xy2(upper, bar_index, upperEndPrice)
if na(lower) and not na(lowerStartPrice)
    lower := line.new(bar_index - lengthInput + 1, lowerStartPrice, bar_index, lowerEndPrice, width=1, extend=extendStyle, color=color.new(colorLower, 0))
else
    line.set_xy1(lower, bar_index - lengthInput + 1, lowerStartPrice)
    line.set_xy2(lower, bar_index, lowerEndPrice)
linefill.new(upper, baseLine, color = colorUpper)
linefill.new(baseLine, lower, color = colorLower)

float trend = math.sign(startPrice - endPrice)
alertcondition(sourceInput > line.get_price(upper, bar_index) or sourceInput < line.get_price(lower, bar_index), title='Regression Channel Exited', message="The price movement has exited Regression Channel's bounds")
alertcondition(trend[1] >= 0 and trend < 0, title='Switched to Uptrend',   message='The Regression Channel trend switched from Downtrend to Uptrend')
alertcondition(trend[1] <= 0 and trend > 0, title='Switched to Downtrend', message='The Regression Channel trend switched from Uptrend to Downtrend')

// Pearson's R
var label r = na
label.delete(r[1])
if showPearsonInput and not na(pearsonR)
    r := label.new(bar_index - lengthInput + 1, lowerStartPrice, str.tostring(pearsonR, "#.################"), color = color.new(color.white, 100), textcolor=color.new(colorUpper, 0), size=size.normal, style=label.style_label_up)
// end
