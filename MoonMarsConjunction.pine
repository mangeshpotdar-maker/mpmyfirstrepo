var int[] shiftedConjunctionEndTimes = array.new_int()
var int[] shiftedAmavasyaStartTimes = array.new_int()
var int[] shiftedAmavasyaEndTimes = array.new_int()

// Function to check if a given timestamp is a weekend or holiday
isTradingDay(t) =>
    // Check for weekend (Saturday=7, Sunday=1 in Pine Script)
    isWeekend = dayofweek(t, "Asia/Kolkata") == dayofweek.saturday or dayofweek(t, "Asia/Kolkata") == dayofweek.sunday

    // Check for holiday
    isHoliday = false
    currentYear = year(t, "Asia/Kolkata")

    holidayList = nseHolidays2023
    if currentYear == 2024
        holidayList := nseHolidays2024
    else if currentYear == 2025
        holidayList := nseHolidays2025
    else if currentYear == 2026
        holidayList := nseHolidays2026

    for i = 0 to array.size(holidayList) - 1
        holidayTimestamp = array.get(holidayList, i)
        // Compare year, month, and day
        if year(t, "Asia/Kolkata") == year(holidayTimestamp, "Asia/Kolkata") and month(t, "Asia/Kolkata") == month(holidayTimestamp, "Asia/Kolkata") and dayofmonth(t, "Asia/Kolkata") == dayofmonth(holidayTimestamp, "Asia/Kolkata")
            isHoliday := true
            break

    not isWeekend and not isHoliday

// Function to find the next trading day
getNextTradingDay(t) =>
    nextDay = t
    while not isTradingDay(nextDay)
        // Increment by one day (in seconds)
        nextDay := nextDay + 24 * 60 * 60 * 1000
    nextDay

