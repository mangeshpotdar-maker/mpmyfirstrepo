    array.push(amavasyaStartTimes, timestamp(2027, 3, 7, 08, 16))
    array.push(amavasyaEndTimes, timestamp(2027, 3, 8, 09, 28))
    array.push(amavasyaStartTimes, timestamp(2027, 4, 6, 00, 10))
    array.push(amavasyaEndTimes, timestamp(2027, 4, 7, 23, 50))
    array.push(amavasyaStartTimes, timestamp(2027, 5, 5, 12, 46))
    array.push(amavasyaEndTimes, timestamp(2027, 5, 6, 10, 57))
    array.push(amavasyaStartTimes, timestamp(2027, 6, 3, 22, 35))
    array.push(amavasyaEndTimes, timestamp(2027, 6, 4, 19, 39))
    array.push(amavasyaStartTimes, timestamp(2027, 7, 3, 06, 35))
    array.push(amavasyaEndTimes, timestamp(2027, 7, 4, 03, 01))
    array.push(amavasyaStartTimes, timestamp(2027, 8, 1, 13, 49))
    array.push(amavasyaEndTimes, timestamp(2027, 8, 2, 10, 04))
    array.push(amavasyaStartTimes, timestamp(2027, 8, 30, 21, 10))
    array.push(amavasyaEndTimes, timestamp(2027, 8, 31, 17, 40))
    array.push(amavasyaStartTimes, timestamp(2027, 9, 29, 05, 24))
    array.push(amavasyaEndTimes, timestamp(2027, 9, 30, 02, 35))
    array.push(amavasyaStartTimes, timestamp(2027, 10, 28, 15, 17))
    array.push(amavasyaEndTimes, timestamp(2027, 10, 29, 13, 35))
    array.push(amavasyaStartTimes, timestamp(2027, 11, 27, 03, 37))
    array.push(amavasyaEndTimes, timestamp(2027, 11, 28, 03, 23))
    array.push(amavasyaStartTimes, timestamp(2027, 12, 26, 18, 52))
    array.push(amavasyaEndTimes, timestamp(2027, 12, 27, 20, 11))

    // Pre-calculate shifted times once
    for i = 0 to array.size(conjunctionStartTimes) - 1
        originalStartTime = array.get(conjunctionStartTimes, i)
        originalEndTime = array.get(conjunctionEndTimes, i)
        duration = originalEndTime - originalStartTime

        shiftedStartTime = getNextTradingDay(originalStartTime)
        shiftedEndTime = shiftedStartTime + duration

        array.push(shiftedConjunctionStartTimes, shiftedStartTime)
        array.push(shiftedConjunctionEndTimes, shiftedEndTime)

    for i = 0 to array.size(amavasyaStartTimes) - 1
        originalStartTime = array.get(amavasyaStartTimes, i)
        originalEndTime = array.get(amavasyaEndTimes, i)
        duration = originalEndTime - originalStartTime

        shiftedStartTime = getNextTradingDay(originalStartTime)
        shiftedEndTime = shiftedStartTime + duration

        array.push(shiftedAmavasyaStartTimes, shiftedStartTime)
        array.push(shiftedAmavasyaEndTimes, shiftedEndTime)


// Function to check if a given time is within any conjunction period
isConjunction(t) =>
    inConjunction = false
    for i = 0 to array.size(shiftedConjunctionStartTimes) - 1
        startTime = array.get(shiftedConjunctionStartTimes, i)
        endTime = array.get(shiftedConjunctionEndTimes, i)
        if t >= startTime and t < endTime
            inConjunction := true
            break
    inConjunction

// Function to check if a given time is within any Amavasya period
isAmavasya(t) =>
    inAmavasya = false
    for i = 0 to array.size(shiftedAmavasyaStartTimes) - 1
        startTime = array.get(shiftedAmavasyaStartTimes, i)
        endTime = array.get(shiftedAmavasyaEndTimes, i)
        if t >= startTime and t < endTime
            inAmavasya := true
            break
    inAmavasya

// Determine if the current bar is in a conjunction or Amavasya period
bool inConjunctionNow = isConjunction(time)
bool inAmavasyaNow = isAmavasya(time)

// Determine if the previous bar was in a conjunction or Amavasya period
bool inConjunctionPreviously = isConjunction(time_close[1])
bool inAmavasyaPreviously = isAmavasya(time_close[1])

// User-configurable options
showConjunctionHighlights = input.bool(true, title="Show Conjunction Highlights", group="Display Settings")
conjunctionHighlightColor = input.color(color.new(color.blue, 80), title="Conjunction Highlight Color", group="Display Settings")
showConjunctionLabels = input.bool(true, title="Show Conjunction Labels", group="Display Settings")
conjunctionLabelText = input.string("🌕♂️ Moon-Mars\nConjunction", title="Conjunction Label Text", group="Display Settings")

showAmavasyaHighlights = input.bool(true, title="Show Amavasya Highlights", group="Display Settings")
amavasyaHighlightColor = input.color(color.new(color.orange, 80), title="Amavasya Highlight Color", group="Display Settings")
showAmavasyaLabels = input.bool(true, title="Show Amavasya Labels", group="Display Settings")
amavasyaLabelText = input.string("🌑 Amavasya", title="Amavasya Label Text", group="Display Settings")


// Add a label and vertical line at the beginning of each conjunction period
if inConjunctionNow and not inConjunctionPreviously
    if showConjunctionLabels
        label.new(bar_index, high, conjunctionLabelText,
                  color=conjunctionHighlightColor,
                  textcolor=color.white,
                  style=label.style_label_down,
                  yloc=yloc.abovebar,
                  tooltip="Start of Moon-Mars Conjunction period")
    if showConjunctionHighlights
        line.new(bar_index, low, bar_index, high, extend=extend.both, color=conjunctionHighlightColor, width=1)

// Add a label at the beginning of each Amavasya period
if inAmavasyaNow and not inAmavasyaPreviously and showAmavasyaLabels
    label.new(bar_index, high, amavasyaLabelText,
              color=amavasyaHighlightColor,
              textcolor=color.white,
              style=label.style_label_down,
              yloc=yloc.abovebar,
              tooltip="Start of Amavasya period")

// Highlight the background color during Amavasya periods
bgcolor(inAmavasyaNow and showAmavasyaHighlights ? amavasyaHighlightColor : na, title="Amavasya Highlight")


// Alert for the start of a conjunction period
if inConjunctionNow and not inConjunctionPreviously
    alert("Moon-Mars Conjunction period starting now", freq = alert.freq_once_per_bar)

// Alert for the start of an Amavasya period
if inAmavasyaNow and not inAmavasyaPreviously
    alert("Amavasya period starting now", freq = alert.freq_once_per_bar)
